# noiz backend configuration — copy to .env and fill in the secrets.
# Compose refuses to start without NOIZ_JWT_SECRET and NOIZ_STREAM_HMAC_SECRET.

# --- required secrets -------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NOIZ_JWT_SECRET=change-me
NOIZ_STREAM_HMAC_SECRET=change-me

# --- database / queue -------------------------------------------------------
POSTGRES_PASSWORD=noiz
NOIZ_DATABASE_URL=postgresql://noiz:noiz@postgres:5432/noiz
NOIZ_REDIS_URL=redis://redis:6379/0

# --- storage ----------------------------------------------------------------
# Media lives in named volumes; the API mounts it read-only, the worker read-write.
NOIZ_MEDIA_ROOT=/media
NOIZ_INBOX_ROOT=/inbox

# --- streaming --------------------------------------------------------------
# X-Accel-Redirect hands byte serving to nginx (production). Set false to make
# FastAPI stream ranges itself (development without TLS in front).
NOIZ_X_ACCEL_ENABLED=true
NOIZ_X_ACCEL_INTERNAL_PREFIX=/_media

# Offline-file encryption policy (PRD §17.3): operator decides per deployment.
# Values: off | optional | required
NOIZ_OFFLINE_ENCRYPTION_POLICY=optional

# --- ingest -----------------------------------------------------------------
# Comma-separated import roots scanned by the ingest worker.
NOIZ_IMPORT_ROOTS=/inbox
# yt-dlp source (admin-only, audit-logged). Keep disabled unless you accept the
# terms of the platforms you fetch from; the operator is responsible for rights.
NOIZ_YTDLP_ENABLED=false
NOIZ_YTDLP_BIN=ytdlp

# --- metadata providers (PRD §17.4) ------------------------------------------
# MusicBrainz ships enabled; it is keyless. Respect their 1 req/s policy.
NOIZ_MUSICBRAINZ_ENABLED=true
NOIZ_MUSICBRAINZ_EMAIL=operator@example.com

# Groq-powered discovery (recommendations, natural-language search, playlist gen).
# Free key: https://console.groq.com/keys
NOIZ_GROQ_ENABLED=false
NOIZ_GROQ_API_KEY=
NOIZ_GROQ_MODEL=llama-3.3-70b-versatile

# --- scrobbling (opt-in per user; tokens live server-side) --------------------
NOIZ_LASTFM_ENABLED=false
NOIZ_LASTFM_API_KEY=
NOIZ_LASTFM_API_SECRET=

# --- misc --------------------------------------------------------------------
NOIZ_ENVIRONMENT=production
NOIZ_DEBUG=false
TZ=UTC
